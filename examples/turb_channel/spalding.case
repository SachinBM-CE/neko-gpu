{
  "version": 1.0,
  "case": 
  {
    "mesh_file": "box.nmsh", 
    "output_at_end": true,
    "output_boundary": true,
    "output_checkpoints": true,
    "checkpoint_control": "simulationtime",
    "checkpoint_value": 50,
    "restart_file": "fluid00002.chkp",
    "time": 
    {
      "end_time": 200.0,
      "variable_timestep": true,
      "target_cfl": 0.5,
      "max_timestep": 1e-1
    },
    "numerics": 
    {
      "time_order": 3,
      "polynomial_order": 7,
      "dealias": true
    },
    "fluid": 
    {
      "scheme": "pnpn",
      "Re": 20000,
      "nut_field": "nut",
      "full_stress_formulation": true,
      "initial_condition": 
      {
        "type": "user"
      },
      "velocity_solver": 
      {
        "type": "fused_coupled_cg",
        "preconditioner": 
        {
          "type": "jacobi"
        },
        "projection_space_size": 0,
        "absolute_tolerance": 1e-4,
        "max_iterations": 800
      },
      "pressure_solver": 
      {
        "type": "gmres",
        "preconditioner": 
        {
          "type": "hsmg"
        },
        "projection_space_size": 5,
        "absolute_tolerance": 1e-3,
        "max_iterations": 800
      },
      "boundary_conditions": 
      [
        {
          "type": "wall_model",
          "model": "spalding",
          "kappa": 0.41,
          "B": 5.2,
          "h_index": 1,
          "zone_indices": [3,4]
        }
      ],
      "flow_rate_force": 
      {
        "direction": 1,
        "value": 1,
        "use_averaged_flow": true
      },
      "output_control": "simulationtime",
      "output_value": 1.0
    },
    "simulation_components": 
    [
      {
        "type": "field_writer",
        "fields": ["tau", "reward", "slope", "intercept"],
        "output_control" : "global",
        "output_filename": "tau"
      },
      {
        "type": "fluid_stats",
        "start_time": 60,
        "output_control": "simulationtime",
        "output_value": 5.0,
        "compute_control": "tsteps",
        "compute_value": 50,
        "avg_direction": "xz",
        "set_of_stats": "basic"
      },
      {
        "type": "les_model",
        "model": "sigma",
        "delta_type": "pointwise",
        "nut_field": "nut",
        "output_control": "global",
        "output_filename": "les"
      },
      {
        "type": "force_torque",
        "output_control": "global",
        "compute_control": "tsteps",
        "compute_value": 50,
        "zone_id": 3,
        "zone_name": "Bottom wall",
        "center": [0, 0, 0],
        "scale": 0.01899
      },
      {
        "type": "force_torque",
        "output_control": "global",
        "compute_control": "tsteps",
        "compute_value": 50,
        "zone_id": 4,
        "zone_name": "Top wall",
        "center": [0, 0, 0],
        "scale": 0.01899
      }
    ]
  }
}
